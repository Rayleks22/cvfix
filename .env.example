# Server-only settings. Never prefix a secret with VITE_.
# Leave these blank for local free-review and sample-editor development.
SESSION_SECRET=
PAYSTACK_SECRET_KEY=
APP_URL=https://cvfix.com.ng
SUPPORT_EMAIL=

# SESSION_SECRET: generate at least 32 random characters and store securely.
# PAYSTACK_SECRET_KEY: use sk_test_... first; only switch to sk_live_... after real test-mode acceptance testing.
# SUPPORT_EMAIL: a real, monitored address you control. Required before paid checkout can be enabled.
# For Cloudflare Pages set these as runtime secrets/variables in the dashboard, not only build variables.
