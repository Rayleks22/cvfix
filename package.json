{
  "name": "cvfix",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build && node scripts/build-pages.js",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "sync-jobs": "node scripts/fetch-remote-jobs.js",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\" \"server/**/*.ts\" \"functions/**/*.ts\" \"scripts/*.js\" \"tests/**/*.{ts,js}\" \"*.{json,ts,html,md}\" \"public/*.{html,json}\" \".github/workflows/*.yml\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\" \"server/**/*.ts\" \"functions/**/*.ts\" \"scripts/*.js\" \"tests/**/*.{ts,js}\" \"*.{json,ts,html,md}\" \"public/*.{html,json}\" \".github/workflows/*.yml\""
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.2.0",
    "@fontsource/dm-serif-display": "^5.2.0",
    "buffer": "^6.0.3",
    "docx": "9.5.1",
    "jspdf": "^4.2.0",
    "lucide-react": "^0.475.0",
    "mammoth": "^1.11.0",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250214.0",
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^6.1.1",
    "axe-core": "^4.13.0",
    "prettier": "^3.9.9",
    "typescript": "^5.7.3",
    "vite": "^8.3.2",
    "vitest": "^4.1.0"
  },
  "optionalDependencies": {
    "@rolldown/binding-win32-x64-msvc": "^1.2.12"
  }
}
